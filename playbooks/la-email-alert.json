{
    "$schema":  "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions":  {
                    "HTTP_Post_Sentinel_Comment":  {
                                                       "inputs":  {
                                                                      "authentication":  {
                                                                                             "type":  "ManagedServiceIdentity"
                                                                                         },
                                                                      "body":  {
                                                                                   "properties":  {
                                                                                                      "message":  "Email alert sent for this incident (Severity: @{triggerBody()?[\u0027Severity\u0027]})."
                                                                                                  }
                                                                               },
                                                                      "method":  "PUT",
                                                                      "uri":  "https://management.azure.com@{triggerBody()?[\u0027IncidentArmId\u0027]}/comments/@{guid()}?api-version=2024-01-01-preview"
                                                                  },
                                                       "runAfter":  {
                                                                        "Send_Email":  [
                                                                                           "Succeeded"
                                                                                       ]
                                                                    },
                                                       "type":  "Http"
                                                   },
                    "Send_Email":  {
                                       "inputs":  {
                                                      "body":  {
                                                                   "content":  {
                                                                                   "plainText":  "A Sentinel incident requires attention.\n\nSeverity: @{triggerBody()?[\u0027Severity\u0027]}\nDescription: @{triggerBody()?[\u0027Description\u0027]}\nIncident: @{triggerBody()?[\u0027IncidentArmId\u0027]}",
                                                                                   "subject":  "[SOC Lab] Sentinel Incident Alert - Severity: @{triggerBody()?[\u0027Severity\u0027]}"
                                                                               },
                                                                   "recipients":  {
                                                                                      "to":  [
                                                                                                 {
                                                                                                     "address":  "tarunteja.desireddy9@gmail.com"
                                                                                                 }
                                                                                             ]
                                                                                  },
                                                                   "senderAddress":  "DoNotReply@81d398a2-4022-44d8-a139-5db45927b574.azurecomm.net"
                                                               },
                                                      "host":  {
                                                                   "connection":  {
                                                                                      "name":  "@parameters(\u0027$connections\u0027)[\u0027acsemail\u0027][\u0027connectionId\u0027]"
                                                                                  }
                                                               },
                                                      "method":  "post",
                                                      "path":  "/emails:send",
                                                      "queries":  {
                                                                      "api-version":  "2023-03-31"
                                                                  }
                                                  },
                                       "runAfter":  {

                                                    },
                                       "type":  "ApiConnection"
                                   }
                },
    "contentVersion":  "1.0.0.0",
    "parameters":  {
                       "$connections":  {
                                            "type":  "Object"
                                        }
                   },
    "triggers":  {
                     "manual":  {
                                    "inputs":  {
                                                   "schema":  {
                                                                  "properties":  {
                                                                                     "Description":  {
                                                                                                         "type":  "string"
                                                                                                     },
                                                                                     "IncidentArmId":  {
                                                                                                           "type":  "string"
                                                                                                       },
                                                                                     "Severity":  {
                                                                                                      "type":  "string"
                                                                                                  }
                                                                                 },
                                                                  "required":  [
                                                                                   "IncidentArmId",
                                                                                   "Severity",
                                                                                   "Description"
                                                                               ],
                                                                  "type":  "object"
                                                              }
                                               },
                                    "kind":  "Http",
                                    "type":  "Request"
                                }
                 }
}
