{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "KeyVaultName": {
      "type": "String",
      "metadata": { "description": "Name of the Key Vault holding VirusTotalApiKey and OTXApiKey secrets. The playbook's managed identity needs Key Vault Secrets User on this vault." }
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "IncidentArmId": { "type": "string" },
            "IPAddress": { "type": "string" }
          },
          "required": ["IncidentArmId", "IPAddress"]
        }
      }
    }
  },
  "actions": {
    "Get_VT_Key_From_KeyVault": {
      "type": "Http",
      "runAfter": {},
      "inputs": {
        "method": "GET",
        "uri": "https://@{parameters('KeyVaultName')}.vault.azure.net/secrets/VirusTotalApiKey?api-version=7.4",
        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://vault.azure.net" }
      }
    },
    "Get_OTX_Key_From_KeyVault": {
      "type": "Http",
      "runAfter": {},
      "inputs": {
        "method": "GET",
        "uri": "https://@{parameters('KeyVaultName')}.vault.azure.net/secrets/OTXApiKey?api-version=7.4",
        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://vault.azure.net" }
      }
    },
    "HTTP_VirusTotal_Lookup": {
      "type": "Http",
      "runAfter": { "Get_VT_Key_From_KeyVault": ["Succeeded"] },
      "inputs": {
        "method": "GET",
        "uri": "https://www.virustotal.com/api/v3/ip_addresses/@{triggerBody()?['IPAddress']}",
        "headers": { "x-apikey": "@{body('Get_VT_Key_From_KeyVault')?['value']}" }
      }
    },
    "HTTP_OTX_Lookup": {
      "type": "Http",
      "runAfter": { "Get_OTX_Key_From_KeyVault": ["Succeeded"] },
      "inputs": {
        "method": "GET",
        "uri": "https://otx.alienvault.com/api/v1/indicators/IPv4/@{triggerBody()?['IPAddress']}/general",
        "headers": { "X-OTX-API-KEY": "@{body('Get_OTX_Key_From_KeyVault')?['value']}" }
      }
    },
    "Parse_VT_Response": {
      "type": "ParseJson",
      "runAfter": { "HTTP_VirusTotal_Lookup": ["Succeeded"] },
      "inputs": {
        "content": "@body('HTTP_VirusTotal_Lookup')",
        "schema": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "attributes": {
                  "type": "object",
                  "properties": {
                    "last_analysis_stats": {
                      "type": "object",
                      "properties": {
                        "malicious": { "type": "integer" },
                        "suspicious": { "type": "integer" },
                        "harmless": { "type": "integer" },
                        "undetected": { "type": "integer" }
                      }
                    },
                    "country": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Parse_OTX_Response": {
      "type": "ParseJson",
      "runAfter": { "HTTP_OTX_Lookup": ["Succeeded"] },
      "inputs": {
        "content": "@body('HTTP_OTX_Lookup')",
        "schema": {
          "type": "object",
          "properties": {
            "reputation": { "type": "integer" },
            "country_name": { "type": "string" },
            "asn": { "type": "string" },
            "pulse_info": {
              "type": "object",
              "properties": { "count": { "type": "integer" } }
            }
          }
        }
      }
    },
    "Compose_VT_Summary": {
      "type": "Compose",
      "runAfter": { "Parse_VT_Response": ["Succeeded", "Skipped", "Failed"] },
      "inputs": "@if(equals(actions('Parse_VT_Response')?['status'], 'Succeeded'), concat('VirusTotal: malicious=', string(body('Parse_VT_Response')?['data']?['attributes']?['last_analysis_stats']?['malicious']), ', suspicious=', string(body('Parse_VT_Response')?['data']?['attributes']?['last_analysis_stats']?['suspicious']), ', harmless=', string(body('Parse_VT_Response')?['data']?['attributes']?['last_analysis_stats']?['harmless']), ', country=', string(body('Parse_VT_Response')?['data']?['attributes']?['country'])), 'VirusTotal: unavailable (rate limited or error)')"
    },
    "Compose_OTX_Summary": {
      "type": "Compose",
      "runAfter": { "Parse_OTX_Response": ["Succeeded", "Skipped", "Failed"] },
      "inputs": "@if(equals(actions('Parse_OTX_Response')?['status'], 'Succeeded'), concat('AlienVault OTX: pulses=', string(body('Parse_OTX_Response')?['pulse_info']?['count']), ', reputation=', string(body('Parse_OTX_Response')?['reputation']), ', country=', string(body('Parse_OTX_Response')?['country_name']), ', ASN=', string(body('Parse_OTX_Response')?['asn'])), 'AlienVault OTX: unavailable (error)')"
    },
    "Compose_Final_Summary": {
      "type": "Compose",
      "runAfter": {
        "Compose_VT_Summary": ["Succeeded"],
        "Compose_OTX_Summary": ["Succeeded"]
      },
      "inputs": "Multi-source IP enrichment for @{triggerBody()?['IPAddress']}. @{outputs('Compose_VT_Summary')} | @{outputs('Compose_OTX_Summary')}"
    },
    "HTTP_Post_Sentinel_Comment": {
      "type": "Http",
      "runAfter": { "Compose_Final_Summary": ["Succeeded"] },
      "inputs": {
        "method": "PUT",
        "uri": "https://management.azure.com@{triggerBody()?['IncidentArmId']}/comments/@{guid()}?api-version=2024-01-01-preview",
        "authentication": { "type": "ManagedServiceIdentity" },
        "body": {
          "properties": { "message": "@outputs('Compose_Final_Summary')" }
        }
      }
    }
  }
}
