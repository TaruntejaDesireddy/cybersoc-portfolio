{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "IncidentArmId": { "type": "string" },
            "UserObjectId": { "type": "string" },
            "Severity": { "type": "string" }
          },
          "required": ["IncidentArmId", "UserObjectId", "Severity"]
        }
      }
    }
  },
  "actions": {
    "Condition_High_Severity": {
      "type": "If",
      "expression": {
        "and": [
          { "equals": ["@triggerBody()?['Severity']", "High"] }
        ]
      },
      "runAfter": {},
      "actions": {
        "HTTP_Post_Sentinel_Comment_Recommend": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "PUT",
            "uri": "https://management.azure.com@{triggerBody()?['IncidentArmId']}/comments/@{guid()}?api-version=2024-01-01-preview",
            "authentication": { "type": "ManagedServiceIdentity" },
            "body": {
              "properties": {
                "message": "HIGH SEVERITY: Recommend disabling user account @{triggerBody()?['UserObjectId']}. Automatic account disablement is intentionally not enabled in this environment — requires manual review and action by a SOC analyst."
              }
            }
          }
        }
      },
      "else": {
        "actions": {
          "HTTP_Post_Sentinel_Comment_Skipped": {
            "type": "Http",
            "runAfter": {},
            "inputs": {
              "method": "PUT",
              "uri": "https://management.azure.com@{triggerBody()?['IncidentArmId']}/comments/@{guid()}?api-version=2024-01-01-preview",
              "authentication": { "type": "ManagedServiceIdentity" },
              "body": {
                "properties": {
                  "message": "Containment playbook triggered but severity was not High — no action recommended."
                }
              }
            }
          }
        }
      }
    }
  }
}
