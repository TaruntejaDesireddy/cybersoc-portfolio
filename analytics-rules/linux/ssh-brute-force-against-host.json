                                                                                   "groupByAlertDetails":  null,
                                                                                   "groupByCustomDetails":  null
                                                                               }
                                                 },
                       "customDetails":  {
                                             "FailedAttempts":  "FailedAttempts",
                                             "SourceIP":  "SourceIP",
                                             "TargetHost":  "Computer",
                                             "SampleMessages":  "Messages"
                                         },
                       "entityMappings":  [
                                              {
                                                  "entityType":  "Host",
                                                  "fieldMappings":  [
                                                                        {
                                                                            "identifier":  "HostName",
                                                                            "columnName":  "HostName"
                                                                        }
                                                                    ]
                                              },
