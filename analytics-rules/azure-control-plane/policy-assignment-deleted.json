                       "alertDetailsOverride":  {
                                                    "alertDisplayNameFormat":  "Azure Policy assignment deleted by {{Caller}}",
                                                    "alertDescriptionFormat":  "{{Caller}} from {{CallerIpAddress}} deleted an Azure Policy assignment at {{Resource}}, removing a preventive guardrail."
                                                },
                       "severity":  "Medium",
                       "query":  "AzureActivity\n| where OperationNameValue has \"MICROSOFT.AUTHORIZATION/POLICYASSIGNMENTS\"\n| where OperationNameValue has \"DELETE\"\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, Resource, ResourceGroup\n| extend Account = Caller, IP = CallerIpAddress",
