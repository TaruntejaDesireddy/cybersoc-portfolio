                       "query":  "AzureActivity\n| where OperationNameValue =~ \"MICROSOFT.STORAGE/STORAGEACCOUNTS/DELETE\"\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, Resource, ResourceGroup\n| extend Account = Caller, IP = CallerIpAddress",
