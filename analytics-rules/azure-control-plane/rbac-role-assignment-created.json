                       "alertDetailsOverride":  {
                                                    "alertDisplayNameFormat":  "Azure RBAC role assigned by {{Caller}}",
                                                    "alertDescriptionFormat":  "{{Caller}} from {{CallerIpAddress}} created a role assignment at scope {{Resource}}."
                                                },
                       "severity":  "Medium",
                       "query":  "AzureActivity\n| where OperationNameValue =~ \"MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE\"\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, Resource, ResourceGroup, SubscriptionId, CorrelationId\n| extend Account = Caller, IP = CallerIpAddress",
                       "suppressionDuration":  "PT5H",
                       "suppressionEnabled":  false,
                       "tactics":  [
                                       "PrivilegeEscalation",
                                       "Persistence"
                                   ],
                       "techniques":  [
                                          "T1098"
                                      ],
                       "displayName":  "Azure - RBAC Role Assignment Created",
                       "enabled":  true,
                       "description":  "DETECTS\nCreation of an Azure RBAC role assignment, granting a principal permissions over a subscription, resource group, or resource.\n\nWHY IT MATTERS\nThis is the primary mechanism for gaining and keeping Azure control-plane privilege (MITRE T1098, Account Manipulation). An attacker who assigns themselves Owner or Contributor secures durable access that survives password resets.\n\nTRIAGE\n1. Identify the role granted and the scope. Owner or Contributor at subscription scope is critical.\n2. Identify who received the assignment and whether that principal is known.\n3. Confirm the Caller is authorized to grant RBAC.\n4. Check whether the grantee immediately used the new rights.\n5. If unauthorized: remove the assignment and investigate the granting identity for compromise.\n\nFALSE POSITIVES\nRoutine access provisioning and IaC deployments. High volume in active environments. Tune by excluding known provisioning principals or by alerting only on privileged role definition IDs.\n\nSOURCE\nAzureActivity",
                       "alertRuleTemplateName":  null
                   }
}