                       "alertDetailsOverride":  {
                                                    "alertDisplayNameFormat":  "VM extension deployed to {{Resource}} by {{Caller}}",
                                                    "alertDescriptionFormat":  "{{Caller}} from {{CallerIpAddress}} deployed or updated an extension on virtual machine {{Resource}}."
