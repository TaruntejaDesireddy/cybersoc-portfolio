                       "severity":  "Medium",
                       "query":  "AzureActivity\n| where OperationNameValue has \"MICROSOFT.COMPUTE/VIRTUALMACHINES/EXTENSIONS\"\n| where OperationNameValue has \"WRITE\"\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, Resource, ResourceGroup, OperationNameValue\n| extend Account = Caller, IP = CallerIpAddress, HostName = Resource",
