                                                    "alertDescriptionFormat":  "{{Caller}} from {{CallerIpAddress}} executed a Run Command against virtual machine {{Resource}}, running arbitrary code as SYSTEM or root."
                                                },
                       "severity":  "High",
                       "query":  "AzureActivity\n| where OperationNameValue has \"MICROSOFT.COMPUTE/VIRTUALMACHINES/RUNCOMMAND\"\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, Resource, ResourceGroup, OperationNameValue\n| extend Account = Caller, IP = CallerIpAddress, HostName = Resource",
