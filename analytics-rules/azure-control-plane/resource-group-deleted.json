                       "query":  "AzureActivity\n| where OperationNameValue =~ \"MICROSOFT.RESOURCES/SUBSCRIPTIONS/RESOURCEGROUPS/DELETE\"\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, ResourceGroup, SubscriptionId, CorrelationId\n| extend Account = Caller, IP = CallerIpAddress",
