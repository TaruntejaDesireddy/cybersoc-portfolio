                       "alertDetailsOverride":  {
                                                    "alertDisplayNameFormat":  "Firewall or Bastion changed: {{Resource}} by {{Caller}}",
                                                    "alertDescriptionFormat":  "{{Caller}} performed {{OperationNameValue}} on perimeter control {{Resource}}."
                                                },
                       "severity":  "High",
                       "query":  "AzureActivity\n| where OperationNameValue has_any (\"MICROSOFT.NETWORK/AZUREFIREWALLS\", \"MICROSOFT.NETWORK/BASTIONHOSTS\", \"MICROSOFT.NETWORK/FIREWALLPOLICIES\")\n| where OperationNameValue has_any (\"DELETE\", \"WRITE\")\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, Resource, ResourceGroup, OperationNameValue\n| extend Account = Caller, IP = CallerIpAddress",
                       "suppressionDuration":  "PT5H",
                       "suppressionEnabled":  false,
                       "tactics":  [
                                       "DefenseEvasion"
                                   ],
                       "techniques":  [
                                          "T1562"
                                      ],
                       "displayName":  "Azure - Firewall or Bastion Modified or Deleted",
                       "enabled":  true,
                       "description":  "DETECTS\nModification or deletion of an Azure Firewall, firewall policy, or Bastion host.\n\nWHY IT MATTERS\nThese are the perimeter and the sanctioned administrative access path. Weakening firewall rules opens egress for C2 and exfiltration; deleting Bastion pushes administrators toward exposing RDP and SSH directly, which is exactly the outcome an attacker wants (MITRE T1562, Impair Defenses).\n\nTRIAGE\n1. Determine whether a rule was relaxed, and specifically whether new outbound destinations or inbound sources were permitted.\n2. Confirm the Caller is authorized to manage perimeter controls and a change window is open.\n3. Check for traffic matching any newly permitted rule immediately after the change.\n4. If Bastion was deleted, verify no public IPs or open management ports were introduced as a replacement.\n5. If unauthorized: revert, then investigate the identity and any traffic allowed during the gap.\n\nFALSE POSITIVES\nApproved firewall rule changes and IaC-managed policy updates.\n\nSOURCE\nAzureActivity",
                       "alertRuleTemplateName":  null
                   }
}