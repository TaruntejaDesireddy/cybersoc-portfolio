                       "severity":  "High",
                       "query":  "SigninLogs\n| where UserPrincipalName startswith \"breakglass\"\n| project TimeGenerated, UserPrincipalName, IPAddress, ResultType, AppDisplayName, Location\n| extend Account = UserPrincipalName, IP = IPAddress",
