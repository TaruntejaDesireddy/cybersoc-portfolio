                                                                                   "groupByCustomDetails":  null
                                                                               }
                                                 },
                       "customDetails":  {
                                             "Application":  "AppDisplayName",
                                             "User":  "UserPrincipalName",
                                             "LegacyClient":  "ClientAppUsed",
                                             "Location":  "Location",
                                             "SourceIP":  "IPAddress"
                                         },
                       "entityMappings":  [
                                              {
                                                  "entityType":  "Account",
                                                  "fieldMappings":  [
                                                                        {
